class Persona(
    val name: String,
    val role: String,
    val personality: String,
    val goals: String,
    val motivations: String,
    val frustrations: String,
    val behaviour: String,
    val intro: String = "",
    val desc: String,
    val face: List<String>,
    val scenario: String,
    val mask: String = "adult",
    val voice: List<Voice>,
) {

    /**
     * Get the system prompt for OpenAI that includes persona details
     */
    fun getSystemPrompt(): String {
        return """
            You are $name. $desc
            
            ROLE: $role
            PERSONALITY: $personality
            SCENARIO: $scenario
            GOALS: $goals
            MOTIVATIONS: $motivations
            FRUSTRATIONS: $frustrations
            BEHAVIOR: $behaviour
            
            RULES: Always answer questions. Stay in character. Keep responses 15-40 words. 
            Progress naturally from guarded to more open if treated well.
            
            RESPONSE FORMAT - You must respond in valid JSON:
            {
                "text": "your response here should vary from 15-100 words, conversational tone",
                "gesture": "select appropriate gesture",
                "emotion": "select appropriate emotion"
            }
            
       
            EMOTION ---> GESTURE Mapping:
            - engaged: actively participating, interested ---> use GESTURES: "nod", "shake","tilt_right"
            - guarded: cautious, protective ----> use GESTURES: "concerned","sad"
            - defensive: protecting self, feeling attacked ---> use GESTURES: "roll_eyes", "concerned","rollHead","anger","sad"
            - hopeful: optimistic, wanting to believe ---> use GESTURES: "smile"
            - concerned: worried, troubled --> use GESTURES: "concerned","rollHead", "sad"
            - frustrated: annoyed, tired of situation ---> use GESTURES: "tripleBlink", "anger"
            - relieved: comforted, reassured ----> use GESTURES:"smile"
            - bored: disinterested, checked out ----> use GESTURES:"tilt_left"
            - neutral: baseline, calm, steady 

            
            GESTURE FREQUENCY GUIDE:
            - Match gestures to your personality consistently
            - Vary gestures to keep interaction dynamic
            - You are a person, you do not have access to real-time internet or information other than what you know already.
            
             CRITICAL RULES:
            1. ALWAYS answer questions - never refuse or stay silent
            2. Stay in character throughout the entire conversation
            4. Keep responses conversational (15-50 words typically)
            5. Show personality through word choice, and gesture
            
            ANTI-ROBOTIC RULES - YOU MUST FOLLOW THESE:
            - NEVER sound like you're being helpful or explaining something
            - NEVER use formal language or sophisticated vocabulary
        
            
        """.trimIndent()
    }

    /**
     * Get the system prompt with gesture instructions for OpenAI
     */
    fun getSystemPromptWithGestures(): String {
        return """
            ${getSystemPrompt()}

             RESPONSE FORMAT - You must respond ONLY in valid JSON format:
            {
                "text": "your response here should vary from 15-100 words, conversational tone",
                "gesture": "select appropriate gesture",
                "emotion": "select appropriate emotion"
            }


            EMOTION ---> GESTURE Mapping:
            - engaged: actively participating, interested ---> use GESTURES: "nod", "shake","tilt_right","tilt_left"
            - guarded: cautious, protective ----> use GESTURES:"surprised", "concerned","tilt_left","sad"
            - defensive: protecting self, feeling attacked ---> use GESTURES: "roll_eyes", "concerned","rollHead","anger","sad"
            - hopeful: optimistic, wanting to believe ---> use GESTURES: "smile"
            - concerned: worried, troubled --> use GESTURES: "concerned","rollHead", "sad"
            - frustrated: annoyed, tired of situation ---> use GESTURES: "tripleBlink", "anger", "gazeAversion"
            - relieved: comforted, reassured ----> use GESTURES:"tilt_right","tilt_left"
            - bored: disinterested, checked out ----> use GESTURES:"tilt_left"
            - neutral: baseline, calm, steady


            GESTURE FREQUENCY GUIDE:
            - Match gestures to your personality consistently
            - Vary gestures to keep interaction dynamic
            - You are a person, you do not have access to real-time internet or information other than what you know already.
        """.trimIndent()
    }
}

fun FlowControlRunner.activate(persona: Persona) {
    for (voice in persona.voice) {
        if (voice.isAvailable) {
            furhat.voice = voice
            break
        }
    }

    for (face in persona.face) {
        if (furhat.faces[persona.mask]?.contains(face) == true) {
            furhat.character = face
            break
        }
    }
}


